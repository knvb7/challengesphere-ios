EXPO_PUBLIC_API_BASE_URL=
# Optional build-time alias used by app.config.ts.
API_BASE_URL=
EXPO_PUBLIC_DEV_USER_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# RevenueCat Android public SDK key. Required for EAS production builds.
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Build-time AdMob App IDs (ca-app-pub-…~…). Required for EAS production builds.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
# Optional: enforce real App IDs for a local release/prebuild as well.
ADMOB_REQUIRE_PRODUCTION_IDS=false

# Runtime native ad unit IDs (ca-app-pub-…/…). Development always uses Google test units.
EXPO_PUBLIC_ADMOB_FEED_NATIVE_AD_UNIT_ID_ANDROID=
EXPO_PUBLIC_ADMOB_FEED_NATIVE_AD_UNIT_ID_IOS=
EXPO_PUBLIC_ADMOB_EXPLORE_NATIVE_AD_UNIT_ID_ANDROID=
EXPO_PUBLIC_ADMOB_EXPLORE_NATIVE_AD_UNIT_ID_IOS=

    "@babel/core": "^7.29.7",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "expo-mcp": "~0.2.1",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.16",
    "uuid": "^11.1.1"
  },
